// Connection URLs live in prisma.config.ts, not here: Prisma 7 removed `url`
// and `directUrl` from the schema and connects through a driver adapter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // One schema per module (docs/architecture.md §1.1), plus `platform` for
  // cross-cutting infrastructure that belongs to no module — see the amendment
  // in §1.1. No cross-schema foreign keys and no cross-schema joins: a module
  // reads another's data through its public API, never its tables.
  schemas = ["platform", "identity", "verse", "media", "insights", "notifications", "privacy"]
}

/// Replay protection for write endpoints (§6).
///
/// Mobile networks retry under the client, so the same request can arrive
/// twice. The first attempt claims the key; a retry replays the stored response
/// instead of doing the work again.
///
/// `status` is a string rather than an enum so it can be constrained in SQL
/// alongside the check that a completed row actually carries a response —
/// see the migration.
model IdempotencyKey {
  /// Who the key belongs to: "user:<uuid>" or "anon:<ip>". Keys are scoped so
  /// one client cannot replay or block another's request by guessing a key.
  scope String

  /// The client-supplied Idempotency-Key header value.
  key String

  /// Hash of method, path and body. A repeat of the same key with a different
  /// request is a client bug, and answering it with the first response would
  /// hide that.
  requestFingerprint String @map("request_fingerprint")

  /// in_progress | completed
  status String

  responseStatus Int?  @map("response_status")
  responseBody   Json? @map("response_body")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  /// 24h after creation (§8.7 retention).
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_key")
  @@schema("platform")
}

/// Fixed-window counters for application-level rate limiting (§8.6).
///
/// No Redis: at this scale it would cost more than everything else combined.
/// A fixed window is coarser than a sliding one — a caller can burst across a
/// boundary — but the limits here are about stopping abuse and enumeration,
/// not smoothing traffic.
model RateLimitWindow {
  /// Identifies what is limited and for whom, e.g.
  /// "auth.login:ip=203.0.113.4|email=a@b.c".
  bucket String

  /// Start of the window this row counts, floored to the window size.
  windowStart DateTime @map("window_start") @db.Timestamptz(3)

  count Int @default(0)

  @@id([bucket, windowStart])
  @@index([windowStart])
  @@map("rate_limit_window")
  @@schema("platform")
}

/// A person with an account (§4).
///
/// `emailVerifiedAt` is the single fact about verification rather than a
/// separate status column: a status and a timestamp can disagree, and the one
/// that can disagree is the one that eventually does.
model User {
  /// Client-generated UUIDv7 (§2) — see src/shared/kernel/id.ts.
  id String @id @db.Uuid

  /// Stored already normalised (trimmed, lowercased). The migration adds a
  /// CHECK that enforces that in the database, so a write path that forgets to
  /// normalise fails loudly instead of creating a second account that differs
  /// only in case.
  email String @unique

  /// Argon2id PHC string. Carries its own salt and parameters, which is what
  /// lets the cost be raised later without invalidating existing hashes.
  passwordHash String @map("password_hash")

  displayName String? @map("display_name")

  /// Null until the address is proven. Nothing but verification sets it.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Optimistic concurrency (§2): a write sends the version it read, and a
  /// mismatch is a 409 rather than a silent overwrite.
  version Int @default(0)

  @@map("user")
  @@schema("identity")
}

/// A registration that has been started but not yet proven (architecture.md §4).
///
/// The account does not exist until the address is verified, and the candidate
/// password lives *here*, on the token, rather than on a placeholder user row.
///
/// That is a deliberate departure from §4's "create then activate" wording, and
/// it closes an account pre-hijacking hole. With one user row per address whose
/// password is overwritten by whoever registered most recently, an attacker can
/// register a victim's address first; when the victim registers and then clicks
/// the link in their inbox, the row they activate can carry the attacker's
/// password. Per-token credentials remove the shared mutable state: each link
/// activates the registration that produced it, so the victim clicking *their
/// own* email always gets their own password, whatever the attacker did first.
///
/// There is no `consumedAt`. The row is deleted on redemption — single-use by
/// deletion, which also means an abandoned attempt's password hash is not kept
/// around any longer than its 24h expiry.
model PendingRegistration {
  /// Hex SHA-256 of the token in the emailed link.
  ///
  /// SHA-256 rather than Argon2 — deliberately, and for the opposite reason
  /// passwords use Argon2. A password is low-entropy and guessable, so its hash
  /// must be slow and salted. This token is 256 bits from a CSPRNG, so guessing
  /// is already hopeless, and it has to be *looked up* by value, which a per-row
  /// salt would make impossible.
  tokenHash String @id @map("token_hash")

  /// Normalised the same way User.email is; the migration enforces it.
  email String

  /// Argon2id PHC string for the password this registration was made with.
  passwordHash String @map("password_hash")

  displayName String? @map("display_name")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([email])
  @@index([expiresAt])
  @@map("pending_registration")
  @@schema("identity")
}
