// Connection URLs live in prisma.config.ts, not here: Prisma 7 removed `url`
// and `directUrl` from the schema and connects through a driver adapter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // One schema per module (docs/architecture.md §1.1), plus `platform` for
  // cross-cutting infrastructure that belongs to no module — see the amendment
  // in §1.1. No cross-schema foreign keys and no cross-schema joins: a module
  // reads another's data through its public API, never its tables.
  schemas = ["platform", "identity", "verse", "media", "insights", "notifications", "privacy"]
}

/// Replay protection for write endpoints (§6).
///
/// Mobile networks retry under the client, so the same request can arrive
/// twice. The first attempt claims the key; a retry replays the stored response
/// instead of doing the work again.
///
/// `status` is a string rather than an enum so it can be constrained in SQL
/// alongside the check that a completed row actually carries a response —
/// see the migration.
model IdempotencyKey {
  /// Who the key belongs to: "user:<uuid>" or "anon:<ip>". Keys are scoped so
  /// one client cannot replay or block another's request by guessing a key.
  scope String

  /// The client-supplied Idempotency-Key header value.
  key String

  /// Hash of method, path and body. A repeat of the same key with a different
  /// request is a client bug, and answering it with the first response would
  /// hide that.
  requestFingerprint String @map("request_fingerprint")

  /// in_progress | completed
  status String

  responseStatus Int?  @map("response_status")
  responseBody   Json? @map("response_body")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  /// 24h after creation (§8.7 retention).
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_key")
  @@schema("platform")
}

/// Fixed-window counters for application-level rate limiting (§8.6).
///
/// No Redis: at this scale it would cost more than everything else combined.
/// A fixed window is coarser than a sliding one — a caller can burst across a
/// boundary — but the limits here are about stopping abuse and enumeration,
/// not smoothing traffic.
model RateLimitWindow {
  /// Identifies what is limited and for whom, e.g.
  /// "auth.login:ip=203.0.113.4|email=a@b.c".
  bucket String

  /// Start of the window this row counts, floored to the window size.
  windowStart DateTime @map("window_start") @db.Timestamptz(3)

  count Int @default(0)

  @@id([bucket, windowStart])
  @@index([windowStart])
  @@map("rate_limit_window")
  @@schema("platform")
}

/// A person with an account (§4).
///
/// `emailVerifiedAt` is the single fact about verification rather than a
/// separate status column: a status and a timestamp can disagree, and the one
/// that can disagree is the one that eventually does.
model User {
  /// Client-generated UUIDv7 (§2) — see src/shared/kernel/id.ts.
  id String @id @db.Uuid

  /// Stored already normalised (trimmed, lowercased). The migration adds a
  /// CHECK that enforces that in the database, so a write path that forgets to
  /// normalise fails loudly instead of creating a second account that differs
  /// only in case.
  email String @unique

  /// Argon2id PHC string. Carries its own salt and parameters, which is what
  /// lets the cost be raised later without invalidating existing hashes.
  ///
  /// Null for an account that only ever signs in with Google. A placeholder
  /// hash would be a credential nobody chose and nobody can use, and the one
  /// thing worse than no password is a password you do not know you have.
  passwordHash String? @map("password_hash")

  displayName String? @map("display_name")

  /// Null until the address is proven. Nothing but verification sets it.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Optimistic concurrency (§2): a write sends the version it read, and a
  /// mismatch is a 409 rather than a silent overwrite.
  version Int @default(0)

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  oauthAccounts       OAuthAccount[]

  @@map("user")
  @@schema("identity")
}

/// A registration that has been started but not yet proven (architecture.md §4).
///
/// The account does not exist until the address is verified, and the candidate
/// password lives *here*, on the token, rather than on a placeholder user row.
///
/// That is a deliberate departure from §4's "create then activate" wording, and
/// it closes an account pre-hijacking hole. With one user row per address whose
/// password is overwritten by whoever registered most recently, an attacker can
/// register a victim's address first; when the victim registers and then clicks
/// the link in their inbox, the row they activate can carry the attacker's
/// password. Per-token credentials remove the shared mutable state: each link
/// activates the registration that produced it, so the victim clicking *their
/// own* email always gets their own password, whatever the attacker did first.
///
/// There is no `consumedAt`. The row is deleted on redemption — single-use by
/// deletion, which also means an abandoned attempt's password hash is not kept
/// around any longer than its 24h expiry.
model PendingRegistration {
  /// Hex SHA-256 of the token in the emailed link.
  ///
  /// SHA-256 rather than Argon2 — deliberately, and for the opposite reason
  /// passwords use Argon2. A password is low-entropy and guessable, so its hash
  /// must be slow and salted. This token is 256 bits from a CSPRNG, so guessing
  /// is already hopeless, and it has to be *looked up* by value, which a per-row
  /// salt would make impossible.
  tokenHash String @id @map("token_hash")

  /// Normalised the same way User.email is; the migration enforces it.
  email String

  /// Argon2id PHC string for the password this registration was made with.
  passwordHash String @map("password_hash")

  displayName String? @map("display_name")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([email])
  @@index([expiresAt])
  @@map("pending_registration")
  @@schema("identity")
}

/// A revocable refresh token (architecture.md §4).
///
/// Access tokens are JWTs and cannot be withdrawn once issued — that is the
/// trade for not hitting the database on every request, and it is why they last
/// about fifteen minutes. Revocation lives here instead: signing out, or
/// detecting a stolen token, invalidates the refresh side, and the access token
/// expires on its own shortly after.
///
/// Stored hashed for the same reason verification tokens are: a database leak
/// must not hand over working sessions. SHA-256, unsalted, because the value is
/// 256 bits from a CSPRNG and has to be looked up by value.
model RefreshToken {
  /// Hex SHA-256 of the token handed to the client.
  tokenHash String @id @map("token_hash")

  userId String @map("user_id") @db.Uuid

  /// One sign-in, and every token rotated out of it.
  ///
  /// Rotation replaces a token on every use, so a stolen one is only useful
  /// until the real client next refreshes. What makes theft *detectable* is
  /// this column: if an already-consumed token is presented again, either the
  /// thief or the real client is replaying, and there is no way to tell which.
  /// The safe response is to revoke the whole family and make both sign in
  /// again.
  familyId String @map("family_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  /// Set when exchanged for a new pair. A consumed token presented again is the
  /// reuse signal above, which is why the row is kept rather than deleted.
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  /// Set by sign-out, or by reuse detection revoking the family.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_token")
  @@schema("identity")
}

/// A single-use password reset token (architecture.md §4).
///
/// Separate from PendingRegistration despite the near-identical shape. They
/// mean different things — one carries a password that does not belong to an
/// account yet, the other authorises replacing the password on an account that
/// exists — and they have different lifetimes, different revocation rules and
/// different blast radii. Merging them into a "token" table with a `purpose`
/// column would put a registration one wrong WHERE clause away from being a
/// password reset.
///
/// Hashed for the same reason as every other token here: a database leak must
/// not hand over working account-takeover links.
model PasswordResetToken {
  /// Hex SHA-256 of the token in the emailed link.
  tokenHash String @id @map("token_hash")

  userId String @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  /// Set when redeemed, rather than the row being deleted.
  ///
  /// Unlike a pending registration — which is deleted so an abandoned attempt's
  /// password hash does not linger — this row holds no secret worth expiring
  /// early, and keeping it lets a second click be answered with "already used"
  /// instead of the much less helpful "invalid".
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)

  /// Set when the password changes by any route, which §4 requires: a reset
  /// link that outlives the password it was issued against is a way back in for
  /// whoever requested it.
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
  @@schema("identity")
}

/// A third-party identity linked to an account (architecture.md §4).
///
/// Separate from User rather than columns on it, because "which providers can
/// sign this person in" is a list, not a field. Google today, Apple plausibly
/// later for the native client, and adding one should not be a migration on the
/// user table.
///
/// The unique constraint is on (provider, providerAccountId) — Google's stable
/// subject id, never the email. An email can move between Google accounts and a
/// Google account can change its email; `sub` is the only identifier Google
/// promises is stable and unique forever.
model OAuthAccount {
  provider String

  /// The provider's own id for this person — Google's `sub` claim.
  providerAccountId String @map("provider_account_id")

  userId String @map("user_id") @db.Uuid

  /// The address the provider asserted at link time, kept for support and for
  /// noticing later that it has drifted from ours. Never used to *find* an
  /// account — see the unique constraint above.
  email String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  /// Declared here as well as in the migration that created it. Without this,
  /// every `prisma migrate diff` proposes dropping it — the schema is the
  /// authority for what should exist, and an index only SQL knows about looks
  /// to the diff like one that should not be there. `map` pins the name so the
  /// declaration and the existing index are the same object.
  @@unique([userId, provider], map: "oauth_account_one_per_provider_idx")
  @@index([userId])
  @@map("oauth_account")
  @@schema("identity")
}

/// A tag: the single grouping primitive (CLAUDE.md).
///
/// `ownerId` points at identity.user.id and is deliberately *not* a Prisma
/// relation. Cross-schema foreign keys are what a later split into services
/// would have to unpick (§1.1), so ownership is carried as a plain id and the
/// join never happens in SQL.
model Tag {
  /// Client-generated UUIDv7 (§2).
  id String @id @db.Uuid

  ownerId String @map("owner_id") @db.Uuid

  /// Stored without the leading dot — that is presentation. Normalised
  /// (trimmed, lowercased) before it gets here; the migration adds a CHECK on
  /// the shape so a write path that forgets fails loudly rather than creating
  /// a second `.Barcelona` alongside `.barcelona`.
  name String

  /// What the user typed, when it differs from the normalised name. Null when
  /// there is nothing to remember.
  displayName String? @map("display_name")

  /// private | shared | public. A string with a CHECK rather than an enum, so
  /// the constraint sits next to the others in the migration.
  visibility String @default("private")

  /// Unique per user, so `.m` means one thing everywhere (CLAUDE.md). Null for
  /// a tag with none, including a vertical whose default letter was taken.
  shortcut String?

  /// flight | hotel | restaurant | concert | movie, or null for an ordinary
  /// tag. Only ever selects a set of *suggested* properties — never required
  /// ones.
  vertical String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Optimistic concurrency (§2).
  version Int @default(0)

  verses VerseTag[]
  shares TagShare[]

  @@unique([ownerId, name])
  @@unique([ownerId, shortcut])
  @@index([ownerId])
  /// Trigram index for fuzzy tag and shortcut matching (§8.2): typing "barclona"
  /// should still find `.barcelona-trip`. Declared here with its operator class
  /// rather than left to raw SQL, so `migrate diff` does not propose dropping
  /// an index it cannot see.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("tag")
  @@schema("verse")
}

/// The atomic unit (CLAUDE.md).
///
/// Almost every column is nullable on purpose: a Verse may be nothing but media,
/// a tag and a location. That is a design rule, so the schema must not quietly
/// require more than the domain does.
model Verse {
  id String @id @db.Uuid

  ownerId String @map("owner_id") @db.Uuid

  /// When it happened, freely past or future. Null for a Verse with no moment.
  eventStart DateTime? @map("event_start") @db.Timestamptz(3)

  /// Set only for a range. The migration enforces that it needs a start and
  /// cannot precede one.
  eventEnd DateTime? @map("event_end") @db.Timestamptz(3)

  /// Negative = years before present. Mutually exclusive with the event
  /// columns, enforced by a CHECK: neither Date nor timestamptz reaches 66
  /// million years ago, so this is a float rather than a timestamp (CLAUDE.md).
  deepTimeYears Float? @map("deep_time_years")

  location String?

  /// 0-10, fractional allowed. Range enforced in the migration.
  rating Float?

  /// The free-text note.
  xp String?

  /// Schema-free key/value (jsonb). Values are text; the domain stringifies
  /// numbers and booleans and refuses objects, so this never holds a nested
  /// blob that search would index as braces.
  properties Json @default("{}")

  /// Null means "inherit from my tags", which is the common case. Resolving it
  /// at write time would freeze today's tag visibility into the row, leaving a
  /// Verse public after its tag was made private.
  visibility String?

  /// Where this verse sits on the timeline, in years from 2000-01-01.
  ///
  /// One scale for both representations, so a page can span a booked flight and
  /// the Chicxulub impact without the query knowing which is which: it is
  /// `deepTimeYears` when that is set, otherwise the event date, otherwise when
  /// the verse was written. Ordering on `event_start` alone cannot work —
  /// deep-time rows have none, and no timestamp column could hold them anyway.
  ///
  /// Maintained by the repository on every write rather than being a Postgres
  /// GENERATED column. Prisma cannot model a generated column, and a column the
  /// schema does not know about is exactly the `migrate diff` landmine that
  /// nearly dropped `oauth_account_one_per_provider_idx` in 2.2.
  ///
  /// Deep time is "years before present" while this is "years from 2000", and
  /// the two are reconciled by ignoring the difference: at the magnitudes deep
  /// time is used for — -13.8e9 has three significant figures — a couple of
  /// decades is far below the precision of the data.
  timelineYears Float @map("timeline_years")

  /// Ids owned by the `media` module. An array rather than a join table
  /// because there is no foreign key to be had across a schema boundary
  /// anyway, and the order is the order the user attached them in.
  mediaIds String[] @map("media_ids") @db.Uuid

  /// Full-text index content (§8.2): `xp` weighted highest, then property
  /// values, then the names of the tags the verse carries.
  ///
  /// A real tsvector column rather than a Postgres GENERATED one, and declared
  /// here rather than left to raw SQL, for the reason 2.2 learned the hard way:
  /// anything the Prisma schema does not know about is something the next
  /// `migrate diff` proposes dropping. `Unsupported` means the typed client
  /// cannot read or write it, which is fine — every write in this module is raw
  /// SQL, and that is where the vector is built.
  ///
  /// Tag names are in it, which means renaming a tag has to rewrite its verses'
  /// vectors. `refreshSearchForTag` does that, and there is a test that a
  /// renamed tag is findable under its new name and not its old one.
  searchVector Unsupported("tsvector")? @map("search_vector")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  version Int @default(0)

  tags   VerseTag[]
  shares VerseShare[]

  /// The timeline reads by event time within an owner; the id tiebreak is what
  /// makes cursor pagination stable when two verses share a timestamp.
  /// The timeline's index: one scale, and `id` as the tiebreak that makes
  /// keyset pagination stable when two verses land on the same year.
  @@index([ownerId, timelineYears, id])
  @@index([ownerId, createdAt, id])
  @@index([searchVector], type: Gin)
  @@map("verse")
  @@schema("verse")
}

/// Which verses carry which tags. Both sides live in the `verse` schema, so
/// unlike ownership these really are foreign keys.
model VerseTag {
  verseId String @map("verse_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid

  /// The order the user added them in, which is the order they read best in.
  position Int @default(0)

  verse Verse @relation(fields: [verseId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([verseId, tagId])
  @@index([tagId])
  @@map("verse_tag")
  @@schema("verse")
}

/// A tag shared with another person.
///
/// `permission` already accepts `contribute` even though nothing honours it
/// (CLAUDE.md open decision 1). Modelling it now means settling that question
/// later is a behaviour change rather than a migration.
model TagShare {
  tagId      String @map("tag_id") @db.Uuid
  granteeId  String @map("grantee_id") @db.Uuid
  permission String @default("read")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, granteeId])
  @@index([granteeId])
  @@map("tag_share")
  @@schema("verse")
}

/// A single verse shared with another person, independent of its tags.
model VerseShare {
  verseId    String @map("verse_id") @db.Uuid
  granteeId  String @map("grantee_id") @db.Uuid
  permission String @default("read")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  verse Verse @relation(fields: [verseId], references: [id], onDelete: Cascade)

  @@id([verseId, granteeId])
  @@index([granteeId])
  @@map("verse_share")
  @@schema("verse")
}

/// An uploaded photo (architecture.md §8.3).
///
/// `ownerId` is a plain UUID, not a foreign key into identity.user — the same
/// rule as `Tag.ownerId` and `Verse.ownerId`, and for the same reason: no
/// cross-schema foreign keys, so a module reads another module's data through
/// its public API rather than a join (§1.1).
///
/// The row exists before the bytes do. `requestUpload` creates it in
/// `pending` the moment a client asks for a place to put a file, because the
/// client needs the id immediately to attach it to a Verse composed offline
/// (§8.1) — the same reason Verse ids are minted client-side rather than on
/// save.
model Media {
  /// Client-generated UUIDv7 (§2).
  id String @id @db.Uuid

  ownerId String @map("owner_id") @db.Uuid

  /// pending -> processing -> ready, or -> failed from either of the middle
  /// two. A string with a CHECK rather than an enum, so the constraint sits
  /// next to the others in the migration; the transition rule itself lives in
  /// the domain (modules/media/domain/media.ts), not here — a CHECK can only
  /// constrain a single row's value, not which value it may move *from*.
  status String @default("pending")

  /// One of the three canvas.toBlob outputs — see domain/media.ts for why
  /// nothing else is accepted.
  contentType String @map("content_type")

  /// Declared by the client when requesting the upload URL; verified against
  /// what actually landed in storage when the upload is confirmed.
  declaredSizeBytes Int @map("declared_size_bytes")

  /// Where the original lives in object storage. Never returned in an API
  /// response — a caller gets a short-lived signed URL instead (§8.3).
  storageKey String @unique @map("storage_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Optimistic concurrency (§2).
  version Int @default(0)

  variants MediaVariant[]

  @@index([ownerId])
  @@map("media")
  @@schema("media")
}

/// A derived size of a Media original: `thumb` (256px) or `medium` (1024px),
/// exactly the two §8.3 names. Generated once by the thumbnail worker and
/// never rewritten in place — see domain/variant.ts for why a variant that
/// needed changing gets a new Media row instead.
model MediaVariant {
  mediaId String @map("media_id") @db.Uuid

  /// thumb | medium.
  kind String

  storageKey String @map("storage_key")
  width      Int
  height     Int
  sizeBytes  Int    @map("size_bytes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([mediaId, kind])
  @@map("media_variant")
  @@schema("media")
}
