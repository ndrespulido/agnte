# Copy to .env.local for local development. Every value below has a working
# default, so `npm run dev` runs with no GCP, Cloudflare or Neon account and
# without Docker (docs/architecture.md §7.1).

# local | preview | production — selects the adapter set.
APP_ENV=local

# Injected at build time in CI; only set by hand if you want the status page to
# show something specific locally.
# GIT_SHA=

# Set by the preview deploy workflow. Unused locally.
# NEON_BRANCH=
# PREVIEW_LABEL=

# Postgres. Optional: with both unset the app still runs and the status page
# reports the database as not-configured, so `npm run dev` needs no database
# at all (docs/architecture.md §7.1).
#
# Locally these are the same URL. In production they differ: DATABASE_URL is
# Neon's pooled endpoint and DIRECT_URL its direct one, because the migration
# engine cannot run through PgBouncer. See docs/operations.md §2.
# DATABASE_URL=postgresql://localhost:5432/agnte
# DIRECT_URL=postgresql://localhost:5432/agnte

# Only needed to *author* migrations: `prisma migrate diff` and `migrate dev`
# replay the migration history into a scratch database to compute the diff.
# `migrate deploy`, which is all CI and production run, never touches it.
#   createdb agnte_shadow
# SHADOW_DATABASE_URL=postgresql://localhost:5432/agnte_shadow

# Cloudflare R2. Optional: with these unset, local development uses the
# filesystem adapter under .local-storage/ and needs no Cloudflare account
# (docs/architecture.md §7.1). All four are required together — three of four
# is rejected at boot rather than silently disabling object storage.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=agnte-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Key prefix, so preview environments share one bucket. Set per environment.
# R2_PREFIX=pr-12/

# Resend (architecture.md §3). Optional: with these unset, local development
# prints emails to the terminal — which is where the verification link is
# easiest to click anyway — and needs no Resend account. Both are required
# together; one of two is rejected at boot rather than silently disabling email.
#
# A deployed environment with these unset has no email at all: the status page
# reports it, and POST /v1/auth/register answers 503 rather than accepting a
# registration whose verification link would never be sent.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Agnte <no-reply@your-verified-domain>

# Origin used to build links that go into emails.
#
# When unset it is taken from the incoming request, which is what lets a preview
# environment work without being told its own URL. That trusts a client-supplied
# Host header, so a forged one would put an attacker's domain in a verification
# link carrying the victim's token. Deployed environments set this explicitly.
# APP_BASE_URL=https://agnte.example.com

# HMAC key for signing access tokens (architecture.md §4). 32+ characters.
#
# Unset locally means a throwaway key generated per process, so `npm run dev`
# needs no configuration — at the cost of tokens not surviving a restart.
# Unset in a deployed environment means sign-in answers 503: signing with a
# value that vanishes on the next cold start would log everyone out at random,
# and on a scale-to-zero platform that is constantly.
#
#   openssl rand -hex 32
# JWT_SECRET=

