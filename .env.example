# Copy to .env.local for local development. Every value below has a working
# default, so `npm run dev` runs with no GCP, Cloudflare or Neon account and
# without Docker (docs/architecture.md §7.1).

# local | preview | production — selects the adapter set.
APP_ENV=local

# Injected at build time in CI; only set by hand if you want the status page to
# show something specific locally.
# GIT_SHA=

# Set by the preview deploy workflow. Unused locally.
# NEON_BRANCH=
# PREVIEW_LABEL=

# Postgres. Optional: with both unset the app still runs and the status page
# reports the database as not-configured, so `npm run dev` needs no database
# at all (docs/architecture.md §7.1).
#
# Locally these are the same URL. In production they differ: DATABASE_URL is
# Neon's pooled endpoint and DIRECT_URL its direct one, because the migration
# engine cannot run through PgBouncer. See docs/operations.md §2.
# DATABASE_URL=postgresql://localhost:5432/agnte
# DIRECT_URL=postgresql://localhost:5432/agnte
