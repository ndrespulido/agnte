# Copy to .env.local for local development. Every value below has a working
# default, so `npm run dev` runs with no GCP, Cloudflare or Neon account and
# without Docker (docs/architecture.md §7.1).

# local | preview | production — selects the adapter set.
APP_ENV=local

# Injected at build time in CI; only set by hand if you want the status page to
# show something specific locally.
# GIT_SHA=

# Set by the preview deploy workflow. Unused locally.
# NEON_BRANCH=
# PREVIEW_LABEL=
